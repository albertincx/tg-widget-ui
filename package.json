{
  "name": "tg-widget-ui",
  "version": "0.3.0",
  "description": "Ultra-lightweight, zero-dependency UI component library and compiler for Telegram HTML Widgets (Bot API 10.4).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./components": "./src/components.js",
    "./builder": "./src/builder.js",
    "./client": "./src/client.js",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src/",
    "skills/",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node playground/server.js",
    "playground": "node playground/server.js",
    "test": "node --test test/*.test.js",
    "check:examples": "node examples/checklist-widget.js && node examples/settings-widget.js"
  },
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "telegram-widgets",
    "html-widgets",
    "bot-api-10-4",
    "ui-library",
    "components",
    "zero-dependency",
    "quickjs",
    "ton"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
